<Window x:Class="NovelEngine.Editor.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр"
        Width="1160"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#080C12"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
    <Grid x:Name="RootGrid">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />

        <Grid x:Name="CharacterLayer" Margin="30,30,30,0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <Border x:Name="FadeOverlay"
                Background="Black"
                Opacity="0"
                IsHitTestVisible="False" />

        <Border VerticalAlignment="Bottom"
                Margin="42,0,42,34"
                Padding="26,22"
                CornerRadius="26"
                Background="#D0141924"
                BorderBrush="#50657F"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="NodeTitleText"
                           Foreground="#8092AA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,7" />
                <TextBlock x:Name="SpeakerText"
                           Foreground="#FFD06F"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7" />
                <TextBlock x:Name="DialogueText"
                           Foreground="#F6F8FB"
                           FontSize="18"
                           TextWrapping="Wrap"
                           MinHeight="56" />
                <WrapPanel x:Name="ChoicesPanel" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
