<Window x:Class="NovelEngine.Editor.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр"
        Width="1160"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#080C12"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
    <Grid x:Name="RootGrid">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />

        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas x:Name="CharacterLayer"
                    Width="1920"
                    Height="1080"
                    Background="Transparent" />
        </Viewbox>

        <Border x:Name="FadeOverlay"
                Background="Black"
                Opacity="0"
                IsHitTestVisible="False" />

        <Border x:Name="DebugPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="340"
                Margin="18"
                Padding="14"
                CornerRadius="10"
                Background="#E8111823"
                BorderBrush="#5C7CA5"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="NOVEL ENGINE DEBUG"
                           Foreground="#64DAB7"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="0,0,0,9" />
                <TextBlock x:Name="DebugBuildText"
                           Foreground="#8292A8"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,7" />
                <TextBlock x:Name="DebugStateText"
                           Foreground="#E8EEF6"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom"
                Margin="42,0,42,34"
                Padding="26,22"
                CornerRadius="26"
                Background="#D0141924"
                BorderBrush="#50657F"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="NodeTitleText"
                           Foreground="#8092AA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,7" />
                <TextBlock x:Name="SpeakerText"
                           Foreground="#FFD06F"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7" />
                <TextBlock x:Name="DialogueText"
                           Foreground="#F6F8FB"
                           FontSize="18"
                           TextWrapping="Wrap"
                           MinHeight="56" />
                <WrapPanel x:Name="ChoicesPanel" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
