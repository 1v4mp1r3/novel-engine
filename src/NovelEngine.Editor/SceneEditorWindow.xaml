<Window x:Class="NovelEngine.Editor.SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор сцены"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Редактор расположения персонажей"
                           FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="HintText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Выберите персонажа и перетащите его. Ctrl+T включает масштаб и поворот." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Свободная трансформация  Ctrl+T"
                        Click="ToggleTransform_Click" />
                <Button Content="Сбросить"
                        Click="ResetTransform_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ПЕРСОНАЖИ"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,0,0,9" />
                        <TextBlock x:Name="InheritanceText"
                                   Foreground="#FFD06F"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="3,0,3,10"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom"
                            Margin="0,12,0,0"
                            Padding="9"
                            Background="#101720"
                            CornerRadius="5">
                        <TextBlock x:Name="TransformText"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Персонаж не выбран" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,10,0,0">
                        <Button x:Name="AddLibraryCharacterButton"
                                Content="Из библиотеки"
                                Click="AddLibraryCharacter_Click" />
                        <Button x:Name="RemoveCharacterButton"
                                Content="Убрать со сцены"
                                Background="#4A2932"
                                Click="RemoveCharacter_Click" />
                    </StackPanel>
                    <ListBox x:Name="CharacterList"
                             Background="Transparent"
                             BorderThickness="0"
                             DisplayMemberPath="Name"
                             SelectionChanged="CharacterList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#070A0F"
                    BorderBrush="#34475F"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Viewbox x:Name="StageViewbox" Stretch="Uniform">
                    <Grid x:Name="StageRoot"
                          Width="1920"
                          Height="1080"
                          Background="#101722"
                          ClipToBounds="True"
                          MouseLeftButtonDown="StageRoot_MouseLeftButtonDown">
                        <Image x:Name="BackgroundImage"
                               Stretch="UniformToFill"
                               IsHitTestVisible="False" />
                        <Canvas x:Name="StageCanvas"
                                Width="1920"
                                Height="1080"
                                Background="Transparent" />
                        <TextBlock x:Name="EmptyStateText"
                                   Text="В состоянии этой ноды нет персонажей"
                                   Foreground="#A5B2C5"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ModeText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Режим перемещения" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена"
                        Width="100"
                        IsCancel="True" />
                <Button Content="Применить"
                        Width="110"
                        Background="#305B55"
                        IsDefault="True"
                        Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
