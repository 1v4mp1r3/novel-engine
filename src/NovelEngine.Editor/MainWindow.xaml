<Window x:Class="NovelEngine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NovelEngine.Editor"
        Title="Novel Engine"
        Width="1480"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#111822">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <Menu Grid.Column="0" Background="#111822" Foreground="{StaticResource TextBrush}">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый" InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="Открыть..." InputGestureText="Ctrl+O" Click="OpenProject_Click" />
                <Separator />
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Click="SaveProject_Click" />
                <MenuItem Header="Сохранить как..." InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click" />
                <Separator />
                <MenuItem Header="Выход" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem x:Name="UndoMenuItem"
                          Header="Отменить"
                          InputGestureText="Ctrl+Z"
                          IsEnabled="False"
                          Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem"
                          Header="Повторить"
                          InputGestureText="Ctrl+Y"
                          IsEnabled="False"
                          Click="Redo_Click" />
            </MenuItem>
            <MenuItem Header="Ноды">
                <MenuItem Header="Добавить сцену" Click="AddScene_Click" />
                <MenuItem Header="Добавить диалог" Click="AddDialogue_Click" />
                <Separator />
                <MenuItem Header="Удалить выбранную" InputGestureText="Delete" Click="DeleteNode_Click" />
            </MenuItem>
            <MenuItem Header="Проект">
                <MenuItem Header="Проверить" Click="ValidateProject_Click" />
                <Separator />
                <MenuItem Header="Собрать игру" InputGestureText="Ctrl+B" Click="BuildGame_Click" />
                <MenuItem Header="Запустить игру" InputGestureText="F5" Click="RunProject_Click" />
                <MenuItem Header="Запустить отладку" InputGestureText="F6" Click="DebugGame_Click" />
                <MenuItem Header="Остановить игру" InputGestureText="Shift+F5" Click="StopGame_Click" />
                <MenuItem Header="Предпросмотр выбранной ноды" InputGestureText="Ctrl+F5" Click="PreviewNode_Click" />
                <Separator />
                <MenuItem Header="Центрировать граф" InputGestureText="Home" Click="CenterGraph_Click" />
                <MenuItem Header="Менеджер файлов" Click="OpenAssetManager_Click" />
            </MenuItem>
        </Menu>
            <Border Grid.Column="1"
                    Padding="8,5,8,3"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BuildGameButton"
                            Content="Собрать"
                            ToolTip="Компилировать игру (Ctrl+B)"
                            Padding="11,5"
                            Click="BuildGame_Click" />
                    <Button x:Name="RunGameButton"
                            Content="Запустить"
                            ToolTip="Собрать и запустить игру (F5)"
                            Background="#305B55"
                            Padding="11,5"
                            Click="RunProject_Click" />
                    <Button x:Name="DebugGameButton"
                            Content="Отладка"
                            ToolTip="Собрать и запустить с runtime-диагностикой (F6)"
                            Padding="11,5"
                            Click="DebugGame_Click" />
                    <Button x:Name="StopGameButton"
                            Content="Остановить"
                            ToolTip="Остановить запущенную игру (Shift+F5)"
                            Background="#4A2932"
                            Padding="11,5"
                            IsEnabled="False"
                            Click="StopGame_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="26" Background="#0A0F16">
            <TextBlock x:Name="StatusText" Margin="10,4" Foreground="{StaticResource MutedBrush}" Text="Готово" />
        </Border>

        <Border x:Name="DiagnosticsPanel"
                DockPanel.Dock="Bottom"
                Height="150"
                Padding="10,8"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="DiagnosticsSummaryText"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Скрыть"
                            Padding="10,4"
                            Click="HideDiagnostics_Click" />
                </DockPanel>
                <DataGrid x:Name="DiagnosticsGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Уровень"
                                            Binding="{Binding Severity}"
                                            Width="100" />
                        <DataGridTextColumn Header="Где"
                                            Binding="{Binding Location}"
                                            Width="260" />
                        <DataGridTextColumn Header="Сообщение"
                                            Binding="{Binding Message}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TabControl x:Name="WorkspaceTabs"
                    SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem x:Name="GraphTab" Header="Граф">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="ПРОЕКТ" FontWeight="Bold" FontSize="14" Margin="4,6,0,10" />
                                <TextBox x:Name="ProjectSearchBox"
                                         Margin="0,0,0,10"
                                         ToolTip="Поиск по названию, id, говорящему и тексту ноды"
                                         TextChanged="ProjectSearchBox_TextChanged"
                                         KeyDown="ProjectSearchBox_KeyDown" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Button Content="+ Сцена" Click="AddScene_Click" />
                                <Button Content="+ Диалог" Click="AddDialogue_Click" />
                            </StackPanel>
                            <TreeView x:Name="ProjectTree" SelectedItemChanged="ProjectTree_SelectedItemChanged">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315C56" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#294A46" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <local:GraphSurface x:Name="Graph" Grid.Column="1" />

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="СВОЙСТВА НОДЫ" FontWeight="Bold" FontSize="14" Margin="18,18,18,12" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,0,18,24">
                            <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleBox" />
                            <TextBlock Text="Тип" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="KindText" Margin="0,5,0,10" />
                            <TextBlock Text="Говорящий" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SpeakerBox" />
                            <TextBlock Text="Текст сцены / реплики" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BodyTextBox" Height="92" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                            <CheckBox x:Name="InheritBackgroundCheck" Content="Наследовать фон" Checked="Inheritance_Changed" Unchecked="Inheritance_Changed" />
                            <TextBlock Text="Фон" Style="{StaticResource FieldLabel}" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="42" Margin="7,0,0,0" Click="BrowseBackground_Click" />
                                <TextBox x:Name="BackgroundBox" Margin="0" />
                            </DockPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Папка фонов" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="BackgroundFolderBox"
                                              Margin="0,4,0,0"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="BackgroundFolderBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Фон из файлов" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="BackgroundAssetBox"
                                              Margin="0,4,0,0"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="BackgroundAssetBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="InheritMusicCheck" Content="Наследовать музыку без перезапуска" Checked="Inheritance_Changed" Unchecked="Inheritance_Changed" />
                            <TextBlock Text="Музыка" Style="{StaticResource FieldLabel}" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="42" Margin="7,0,0,0" Click="BrowseMusic_Click" />
                                <TextBox x:Name="MusicBox" Margin="0" />
                            </DockPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Папка музыки" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="MusicFolderBox"
                                              Margin="0,4,0,0"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="MusicFolderBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Музыка из файлов" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="MusicAssetBox"
                                              Margin="0,4,0,0"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="MusicAssetBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="InheritCharactersCheck" Content="Наследовать персонажей" Checked="Inheritance_Changed" Unchecked="Inheritance_Changed" />
                            <TextBlock Text="Персонажи на сцене" Style="{StaticResource SectionHeader}" />
                            <DataGrid x:Name="CharactersGrid" Height="135" AutoGenerateColumns="False" SelectionChanged="CharactersGrid_SelectionChanged" MouseDoubleClick="EditCharacter_Click">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="90" />
                                    <DataGridTextColumn Header="Блипы" Binding="{Binding VoiceCount}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,7,0,0">
                                <Button x:Name="AddCharacterButton" Content="+ Персонаж" Click="AddCharacter_Click" />
                                <Button x:Name="AddLibraryCharacterButton" Content="Из библиотеки" Click="AddLibraryCharacter_Click" />
                                <Button x:Name="SaveCharacterToLibraryButton" Content="В библиотеку" Click="SaveCharacterToLibrary_Click" />
                                <Button x:Name="EditCharacterButton" Content="Изменить" Click="EditCharacter_Click" />
                                <Button x:Name="DeleteCharacterButton" Content="Удалить" Click="DeleteCharacter_Click" />
                            </WrapPanel>

                            <TextBlock Text="Скрипт при входе" Style="{StaticResource SectionHeader}" />
                            <TextBox x:Name="ScriptBox" Height="110" FontFamily="Cascadia Mono" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="Выходы / варианты ответа" Style="{StaticResource SectionHeader}" />
                            <DataGrid x:Name="OutputsGrid" Height="155" AutoGenerateColumns="False" SelectionChanged="OutputsGrid_SelectionChanged" MouseDoubleClick="EditOutput_Click">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Текст" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="Условие" Binding="{Binding Condition}" Width="110" />
                                    <DataGridTextColumn Header="Цель" Binding="{Binding TargetTitle}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,7,0,8">
                                <Button x:Name="AddOutputButton" Content="+ Вариант" Click="AddOutput_Click" />
                                <Button x:Name="EditOutputButton" Content="Изменить" Click="EditOutput_Click" />
                                <Button x:Name="DeleteOutputButton" Content="Удалить" Click="DeleteOutput_Click" />
                                <Button x:Name="DisconnectOutputButton" Content="Разорвать" Click="DisconnectOutput_Click" />
                            </WrapPanel>

                            <Button Content="Предпросмотр ноды" Background="#305B55" Click="PreviewNode_Click" />
                            <Button Content="Применить" Click="ApplyProperties_Click" />
                            <Button Content="Удалить ноду" Background="#4A2932" Click="DeleteNode_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CodeTab" Header="Код">
                <Grid Background="{StaticResource WindowBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="18,7,4,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Ctrl+Space — подсказки · Ctrl+Enter — применить код" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Применить код"
                                        Background="#305B55"
                                        Click="ApplyCode_Click" />
                                <Button Content="Обновить из графа"
                                        Click="UpdateCodeFromGraph_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <local:CodeEditorControl x:Name="CodeEditor"
                                             Grid.Row="1"
                                             Margin="0"
                                             Padding="18,14"
                                             TextChanged="CodeEditor_TextChanged"
                                             SelectionChanged="CodeEditor_SelectionChanged"
                                             PreviewKeyDown="CodeEditor_PreviewKeyDown" />

                    <Border Grid.Row="2"
                            Padding="10,6"
                            Background="#0A0F16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock x:Name="CodeCursorText"
                                       DockPanel.Dock="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Строка 1, столбец 1" />
                            <TextBlock x:Name="CodeStatusText"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Код синхронизирован с графом" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="FilesTab" Header="Файлы">
                <Grid Background="{StaticResource WindowBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="18,7,4,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="В коде используйте @имя_ассета" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Импортировать"
                                        Background="#305B55"
                                        Click="ImportAssets_Click" />
                                <Button x:Name="CreateVoiceBlipButton"
                                        Content="+ Создать блип"
                                        Background="#305B55"
                                        Click="CreateVoiceBlip_Click" />
                                <Button Content="+ Папка"
                                        Click="CreateAssetFolder_Click" />
                                <Button x:Name="RenameFolderButton"
                                        Content="Переименовать папку"
                                        Click="RenameAssetFolder_Click" />
                                <Button x:Name="DeleteFolderButton"
                                        Content="Удалить папку"
                                        Click="DeleteAssetFolder_Click" />
                                <Button x:Name="RenameAssetButton"
                                        Content="Переименовать"
                                        Click="RenameAsset_Click" />
                                <Button x:Name="MoveAssetButton"
                                        Content="Переместить"
                                        Click="MoveAsset_Click" />
                                <Button x:Name="CopyAssetReferenceButton"
                                        Content="Копировать ссылку"
                                        Click="CopyAssetReference_Click" />
                                <Button x:Name="FindAssetUsageButton"
                                        Content="Где используется"
                                        Click="FindAssetUsage_Click" />
                                <Button x:Name="DeleteAssetButton"
                                        Content="Удалить"
                                        Background="#4A2932"
                                        Click="DeleteAsset_Click" />
                                <Button Content="Открыть папку"
                                        Click="OpenAssetsFolder_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="ПАПКИ"
                                               FontWeight="Bold"
                                               Margin="12,10" />
                                    <TreeView x:Name="AssetFoldersTree"
                                              Margin="5"
                                              SelectedItemChanged="AssetFoldersTree_SelectedItemChanged" />
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="AssetsGrid"
                                      Grid.Column="2"
                                      AutoGenerateColumns="False"
                                      SelectionChanged="AssetsGrid_SelectionChanged"
                                      PreviewMouseRightButtonDown="AssetsGrid_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="AssetsGrid_ContextMenuOpening"
                                      MouseDoubleClick="CopyAssetReference_Click">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Имя"
                                                            Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Id}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Тип"
                                                        Binding="{Binding Kind}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="Папка"
                                                        Binding="{Binding Folder}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="Файл"
                                                        Binding="{Binding Path}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Используется"
                                                        Binding="{Binding UsageCount}"
                                                        Width="105" />
                                    <DataGridTextColumn Header="Размер"
                                                        Binding="{Binding Size}"
                                                        Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Border Grid.Column="1"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="ПРЕДПРОСМОТР АССЕТА"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,0,0,14" />
                                <StackPanel>
                                    <Border Height="280"
                                            Background="#0A0F16"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,14">
                                        <Grid>
                                            <Image x:Name="AssetPreviewImage"
                                                   Stretch="Uniform"
                                                   Margin="8" />
                                            <TextBlock x:Name="AssetPreviewPlaceholder"
                                                       Text="Выберите ассет"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Ссылка в коде"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AssetReferenceText"
                                             IsReadOnly="True"
                                             Margin="0,4,0,10" />
                                    <TextBlock Text="Путь"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="AssetPathText"
                                               Margin="0,5,0,12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="AssetUsageText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
